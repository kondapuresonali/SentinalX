<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <selector android:layout_width="wrap_content" android:layout_height="wrap_content">
        <selector android:layout_width="wrap_content" android:layout_height="wrap_content">
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#4D00FFFF" />
                    <corners android:radius="@dimen/button_corner_radius" />
                    <stroke android:width="2dp" android:color="@color/neon_cyan" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3300FFFF" />
                    <corners android:radius="@dimen/button_corner_radius" />
                    <stroke android:width="1dp" android:color="@color/neon_cyan" />
                </shape>
            </item>
        </selector>
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="#4D00FFFF" />
                <corners android:radius="@dimen/button_corner_radius" />
                <stroke android:width="2dp" android:color="@color/neon_cyan" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="#3300FFFF" />
                <corners android:radius="@dimen/button_corner_radius" />
                <stroke android:width="1dp" android:color="@color/neon_cyan" />
            </shape>
        </item>
    </selector>
</selector>